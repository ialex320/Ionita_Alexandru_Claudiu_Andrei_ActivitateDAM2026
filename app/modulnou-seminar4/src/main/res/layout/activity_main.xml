<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="deschideAdaugare"
        android:text="Adauga avion" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="deschideAdaugareAI"
        android:text="Adauga avion (design AI)" />

    <Button
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:onClick="deschideLista"
    android:text="Vezi lista de avioane" />

    <TextView
        android:id="@+id/avion_TV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Niciun avion adaugat" />
</LinearLayout>